        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row justify-content-center">
                        <div class="col-md-10">
                            <!-- Header -->
                            <div class="text-center mb-5">
                                <h1 class="display-4 mb-3">How to Use Vinculum</h1>
                                <p class="lead text-muted">Your complete guide to maximizing your digital business card</p>
                            </div>

                            <!-- Quick Navigation -->
                            <div class="card mb-4 bg-light">
                                <div class="card-body">
                                    <h5 class="mb-3"><i class="fa fa-compass"></i> Quick Navigation</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-unstyled">
                                                <li><a href="#what-is">What is Vinculum?</a></li>
                                                <li><a href="#how-it-works">How It Works</a></li>
                                                <li><a href="#setup">Setting Up Your vCard</a></li>
                                                <li><a href="#sharing">Sharing Your vCard</a></li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-unstyled">
                                                <li><a href="#leads">Collecting Leads</a></li>
                                                <li><a href="#email-marketing">Email Marketing</a></li>
                                                <li><a href="#reviews">Managing Reviews</a></li>
                                                <li><a href="#best-practices">Best Practices</a></li>
                                                <li><a href="#tips">Pro Tips</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 1: What is Vinculum -->
                            <div class="card mb-4" id="what-is">
                                <div class="card-header bg-primary text-white">
                                    <h3 class="mb-0"><i class="fa fa-info-circle"></i> What is Vinculum?</h3>
                                </div>
                                <div class="card-body">
                                    <p class="lead">Vinculum is your all-in-one digital business card platform that helps you network smarter.</p>
                                    <div class="row mt-4">
                                        <div class="col-md-4 mb-3">
                                            <div class="text-center p-3">
                                                <i class="fa fa-id-card fa-3x text-primary mb-3"></i>
                                                <h5>Digital Business Card</h5>
                                                <p class="text-muted">Create a beautiful, mobile-optimized contact page with all your information</p>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="text-center p-3">
                                                <i class="fa fa-qrcode fa-3x text-primary mb-3"></i>
                                                <h5>QR Code &amp; NFC</h5>
                                                <p class="text-muted">Share instantly with QR codes or program NFC cards for tap-to-share</p>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="text-center p-3">
                                                <i class="fa fa-users fa-3x text-primary mb-3"></i>
                                                <h5>Lead Collection &amp; Email Marketing</h5>
                                                <p class="text-muted">Capture contacts, sync to CRM, and run targeted email campaigns</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 2: How It Works -->
                            <div class="card mb-4" id="how-it-works">
                                <div class="card-header bg-success text-white">
                                    <h3 class="mb-0"><i class="fa fa-cogs"></i> How It Works</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <h5 class="mb-3">The Vinculum Flow:</h5>
                                            <div class="timeline">
                                                <div class="d-flex mb-4">
                                                    <div class="mr-3">
                                                        <span class="badge badge-success badge-pill" style="font-size: 18px; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">1</span>
                                                    </div>
                                                    <div>
                                                        <h5>Create Your vCard</h5>
                                                        <p>Fill in your contact information, add your photo, customize colors, add social media links, and create your unique URL slug.</p>
                                                    </div>
                                                </div>
                                                <div class="d-flex mb-4">
                                                    <div class="mr-3">
                                                        <span class="badge badge-success badge-pill" style="font-size: 18px; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">2</span>
                                                    </div>
                                                    <div>
                                                        <h5>Generate Your Page</h5>
                                                        <p>Click "Generate Website" and Vinculum creates your personalized contact page with your branding.</p>
                                                    </div>
                                                </div>
                                                <div class="d-flex mb-4">
                                                    <div class="mr-3">
                                                        <span class="badge badge-success badge-pill" style="font-size: 18px; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">3</span>
                                                    </div>
                                                    <div>
                                                        <h5>Share Your vCard</h5>
                                                        <p>Use your QR code, NFC card, or direct URL to share your contact information instantly.</p>
                                                    </div>
                                                </div>
                                                <div class="d-flex mb-4">
                                                    <div class="mr-3">
                                                        <span class="badge badge-success badge-pill" style="font-size: 18px; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">4</span>
                                                    </div>
                                                    <div>
                                                        <h5>Collect Leads</h5>
                                                        <p>When people visit your page, they can save your contact, fill out your lead form, or leave a review.</p>
                                                    </div>
                                                </div>
                                                <div class="d-flex">
                                                    <div class="mr-3">
                                                        <span class="badge badge-success badge-pill" style="font-size: 18px; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">5</span>
                                                    </div>
                                                    <div>
                                                        <h5>Manage &amp; Market</h5>
                                                        <p>All leads sync to your CRM and email marketing lists where you can follow up, nurture prospects, and run targeted campaigns.</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 3: Setting Up Your vCard -->
                            <div class="card mb-4" id="setup">
                                <div class="card-header bg-info text-white">
                                    <h3 class="mb-0"><i class="fa fa-wrench"></i> Setting Up Your vCard</h3>
                                </div>
                                <div class="card-body">
                                    <h5 class="mb-3">Essential Information:</h5>
                                    <div class="list-group mb-4">
                                        <div class="list-group-item">
                                            <h6><i class="fa fa-user text-primary"></i> Personal Information</h6>
                                            <p class="mb-0 text-muted">Name, company, job title, photo - this is what people see first!</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6><i class="fa fa-phone text-primary"></i> Contact Details</h6>
                                            <p class="mb-0 text-muted">Phone, email, address - make it easy for people to reach you</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6><i class="fa fa-paint-brush text-primary"></i> Branding</h6>
                                            <p class="mb-0 text-muted">Choose your brand colors, customize your about section, add your logo</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6><i class="fa fa-link text-primary"></i> Website Slug</h6>
                                            <p class="mb-0 text-muted">Pick a memorable URL: yourdomain.com/<strong>yourname</strong></p>
                                        </div>
                                    </div>

                                    <h5 class="mb-3">Optional Enhancements:</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-unstyled">
                                                <li class="mb-2"><i class="fa fa-check text-success"></i> Social Media Links</li>
                                                <li class="mb-2"><i class="fa fa-check text-success"></i> Additional Websites</li>
                                                <li class="mb-2"><i class="fa fa-check text-success"></i> Video Introductions</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-unstyled">
                                                <li class="mb-2"><i class="fa fa-check text-success"></i> Calendly Integration</li>
                                                <li class="mb-2"><i class="fa fa-check text-success"></i> Lead Collection Form</li>
                                                <li class="mb-2"><i class="fa fa-check text-success"></i> Reviews Section</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 4: Sharing Your vCard -->
                            <div class="card mb-4" id="sharing">
                                <div class="card-header bg-warning text-white">
                                    <h3 class="mb-0"><i class="fa fa-share-alt"></i> Sharing Your vCard</h3>
                                </div>
                                <div class="card-body">
                                    <p class="lead mb-4">There are three main ways to share your Vinculum vCard:</p>
                                    
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <div class="card h-100 border-primary">
                                                <div class="card-body text-center">
                                                    <i class="fa fa-qrcode fa-4x text-primary mb-3"></i>
                                                    <h5>QR Code</h5>
                                                    <p class="text-muted">Download your QR code and add it to:</p>
                                                    <ul class="text-left small">
                                                        <li>Email signatures</li>
                                                        <li>Business cards</li>
                                                        <li>Marketing materials</li>
                                                        <li>Social media profiles</li>
                                                        <li>Presentations</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card h-100 border-success">
                                                <div class="card-body text-center">
                                                    <i class="fa fa-mobile fa-4x text-success mb-3"></i>
                                                    <h5>NFC Card</h5>
                                                    <p class="text-muted">Program Vinculum cards for instant tap-to-share:</p>
                                                    <ul class="text-left small">
                                                        <li>Tap to any phone</li>
                                                        <li>Works on iOS &amp; Android</li>
                                                        <li>No app needed</li>
                                                        <li>Instant contact sharing</li>
                                                        <li>Professional impression</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card h-100 border-info">
                                                <div class="card-body text-center">
                                                    <i class="fa fa-link fa-4x text-info mb-3"></i>
                                                    <h5>Direct URL</h5>
                                                    <p class="text-muted">Share your personal link:</p>
                                                    <ul class="text-left small">
                                                        <li>Text messages</li>
                                                        <li>Social media bios</li>
                                                        <li>Email signatures</li>
                                                        <li>LinkedIn profile</li>
                                                        <li>Website footer</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 5: Collecting Leads -->
                            <div class="card mb-4" id="leads">
                                <div class="card-header bg-primary text-white">
                                    <h3 class="mb-0"><i class="fa fa-users"></i> Collecting Leads</h3>
                                </div>
                                <div class="card-body">
                                    <div class="alert alert-info">
                                        <i class="fa fa-lightbulb-o"></i> <strong>Pro Tip:</strong> Enable the lead collection form to capture contact information from people who view your vCard!
                                    </div>
                                    
                                    <h5 class="mb-3">Setting Up Lead Collection:</h5>
                                    <ol class="lead-steps">
                                        <li class="mb-3">
                                            <strong>Enable the Form:</strong> In your vCard settings, toggle on "Show the lead collection form"
                                        </li>
                                        <li class="mb-3">
                                            <strong>Customize the Button:</strong> Change the button text to match your goal (e.g., "Get My Free Guide", "Schedule a Meeting")
                                        </li>
                                        <li class="mb-3">
                                            <strong>Add Lead Tags:</strong> Tag leads automatically for easy organization in your CRM
                                        </li>
                                        <li class="mb-3">
                                            <strong>Select Email Marketing List:</strong> Choose which mailing list leads should be added to automatically
                                        </li>
                                        <li class="mb-3">
                                            <strong>Customize Thank You Message:</strong> Set a personalized message that appears after form submission
                                        </li>
                                    </ol>

                                    <h5 class="mb-3">Managing Your Leads:</h5>
                                    <p>All leads automatically appear in your CRM as "Opportunities" and are added to your selected email marketing list where you can:</p>
                                    <ul>
                                        <li>View contact information and lead details</li>
                                        <li>See which vCard generated the lead</li>
                                        <li>Add notes and follow-up activities</li>
                                        <li>Track your conversion funnel</li>
                                        <li>Run targeted email campaigns</li>
                                        <li>Segment contacts by source and tags</li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Section 6: Email Marketing -->
                            <div class="card mb-4" id="email-marketing">
                                <div class="card-header bg-info text-white">
                                    <h3 class="mb-0"><i class="fa fa-envelope"></i> Email Marketing</h3>
                                </div>
                                <div class="card-body">
                                    <p class="lead">Turn your vCard leads into engaged customers with powerful email marketing tools.</p>
                                    
                                    <div class="alert alert-success">
                                        <i class="fa fa-lightbulb-o"></i> <strong>Pro Tip:</strong> Every lead from your vCard is automatically added to your email marketing list, so you can start nurturing them immediately!
                                    </div>
                                    
                                    <h5 class="mb-3">Email Marketing Features:</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <div class="card border-info h-100">
                                                <div class="card-body">
                                                    <h6><i class="fa fa-list text-info"></i> Mailing Lists</h6>
                                                    <p class="text-muted">Organize your contacts into targeted lists (e.g., "Hot Leads", "Newsletter Subscribers", "VIP Clients")</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card border-info h-100">
                                                <div class="card-body">
                                                    <h6><i class="fa fa-paper-plane text-info"></i> Email Campaigns</h6>
                                                    <p class="text-muted">Create and send professional email campaigns to nurture leads and engage customers</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <div class="card border-info h-100">
                                                <div class="card-body">
                                                    <h6><i class="fa fa-tags text-info"></i> Smart Tagging</h6>
                                                    <p class="text-muted">Leads are automatically tagged based on their source, making segmentation easy</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card border-info h-100">
                                                <div class="card-body">
                                                    <h6><i class="fa fa-chart-line text-info"></i> Analytics</h6>
                                                    <p class="text-muted">Track open rates, click rates, and engagement to optimize your campaigns</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <h5 class="mb-3">Getting Started with Email Marketing:</h5>
                                    <ol class="lead-steps">
                                        <li class="mb-3">
                                            <strong>Create Your First Mailing List:</strong> Go to your vCard dashboard and click "Mailing Lists" to create lists for different audiences
                                        </li>
                                        <li class="mb-3">
                                            <strong>Set Up Lead Collection:</strong> In your vCard settings, select which mailing list new leads should be added to
                                        </li>
                                        <li class="mb-3">
                                            <strong>Design Your First Campaign:</strong> Use the email campaign builder to create professional-looking emails
                                        </li>
                                        <li class="mb-3">
                                            <strong>Segment Your Audience:</strong> Use tags and lists to send targeted messages to the right people
                                        </li>
                                        <li class="mb-3">
                                            <strong>Track Performance:</strong> Monitor your email metrics to improve your campaigns over time
                                        </li>
                                    </ol>

                                    <h5 class="mb-3">Email Marketing Best Practices:</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul>
                                                <li><strong>Welcome Series:</strong> Send new leads a welcome email sequence</li>
                                                <li><strong>Value-First Content:</strong> Provide helpful information, not just sales pitches</li>
                                                <li><strong>Consistent Branding:</strong> Use your vCard colors and style in emails</li>
                                                <li><strong>Mobile Optimization:</strong> Ensure emails look great on all devices</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul>
                                                <li><strong>Personalization:</strong> Use contact names and relevant content</li>
                                                <li><strong>Clear CTAs:</strong> Make it obvious what you want recipients to do</li>
                                                <li><strong>Regular Schedule:</strong> Send emails consistently but not too frequently</li>
                                                <li><strong>Test &amp; Optimize:</strong> A/B test subject lines and content</li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="alert alert-warning mt-3">
                                        <i class="fa fa-exclamation-triangle"></i> <strong>Important:</strong> Always comply with email marketing laws (CAN-SPAM, GDPR) and include unsubscribe options in your emails.
                                    </div>
                                </div>
                            </div>

                            <!-- Section 7: Managing Reviews -->
                            <div class="card mb-4" id="reviews">
                                <div class="card-header bg-warning text-white">
                                    <h3 class="mb-0"><i class="fa fa-star"></i> Managing Reviews</h3>
                                </div>
                                <div class="card-body">
                                    <p class="lead">Reviews build trust and credibility on your vCard page.</p>
                                    
                                    <h5 class="mb-3">How It Works:</h5>
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <h6><i class="fa fa-pencil text-warning"></i> Visitors Leave Reviews</h6>
                                            <p class="text-muted">People visiting your vCard can click "Leave a Review" to share their feedback.</p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6><i class="fa fa-check-circle text-success"></i> You Approve</h6>
                                            <p class="text-muted">Reviews are unpublished by default. You decide which ones to display.</p>
                                        </div>
                                    </div>

                                    <h5 class="mb-3">Review Settings:</h5>
                                    <ul>
                                        <li><strong>Show/Hide Reviews Section:</strong> Toggle reviews on/off</li>
                                        <li><strong>Section Title:</strong> Customize the heading (default: "Reviews")</li>
                                        <li><strong>Max Reviews:</strong> Limit how many reviews to display</li>
                                        <li><strong>Autoscroll Speed:</strong> Control carousel transition timing</li>
                                        <li><strong>Thank You Message:</strong> Customize the message after review submission</li>
                                    </ul>

                                    <div class="alert alert-success mt-3">
                                        <i class="fa fa-star"></i> <strong>Best Practice:</strong> Actively request reviews from satisfied clients and customers to build social proof!
                                    </div>
                                </div>
                            </div>

                            <!-- Section 8: Best Practices -->
                            <div class="card mb-4" id="best-practices">
                                <div class="card-header bg-danger text-white">
                                    <h3 class="mb-0"><i class="fa fa-trophy"></i> Best Practices</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5><i class="fa fa-image text-danger"></i> Visual Appeal</h5>
                                            <ul>
                                                <li>Use a professional, high-quality photo</li>
                                                <li>Choose brand colors that represent you/your company</li>
                                                <li>Keep your about section concise but informative</li>
                                                <li>Add your company logo to the QR code</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <h5><i class="fa fa-refresh text-danger"></i> Keep It Updated</h5>
                                            <ul>
                                                <li>Update contact information promptly</li>
                                                <li>Add new social media profiles as you join</li>
                                                <li>Refresh your photo periodically</li>
                                                <li>Update your about section with current focus</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <h5><i class="fa fa-target text-danger"></i> Strategic Sharing</h5>
                                            <ul>
                                                <li>Place QR codes where your audience is</li>
                                                <li>Carry NFC cards to networking events</li>
                                                <li>Add your URL to all digital properties</li>
                                                <li>Include in email signatures</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <h5><i class="fa fa-bar-chart text-danger"></i> Track Performance</h5>
                                            <ul>
                                                <li>Monitor QR code scan count</li>
                                                <li>Review leads generated</li>
                                                <li>Follow up promptly with new contacts</li>
                                                <li>Test different call-to-action buttons</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 9: Pro Tips -->
                            <div class="card mb-4" id="tips">
                                <div class="card-header bg-success text-white">
                                    <h3 class="mb-0"><i class="fa fa-lightbulb-o"></i> Pro Tips for Maximum Impact</h3>
                                </div>
                                <div class="card-body">
                                    <div class="list-group">
                                        <div class="list-group-item">
                                            <h6 class="mb-1"><i class="fa fa-bolt text-warning"></i> Create Multiple vCards</h6>
                                            <p class="mb-0 text-muted">Create different vCards for different contexts (e.g., one for real estate, one for consulting)</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6 class="mb-1"><i class="fa fa-bolt text-warning"></i> Use Custom Buttons</h6>
                                            <p class="mb-0 text-muted">Customize your lead button text to match your offer ("Get My Free Consultation", "Download My Guide")</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6 class="mb-1"><i class="fa fa-bolt text-warning"></i> Add Calendly</h6>
                                            <p class="mb-0 text-muted">Integrate your Calendly link so people can book meetings directly from your vCard</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6 class="mb-1"><i class="fa fa-bolt text-warning"></i> Leverage Video</h6>
                                            <p class="mb-0 text-muted">Add introduction videos to create a personal connection before you even meet</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6 class="mb-1"><i class="fa fa-bolt text-warning"></i> Test Your vCard</h6>
                                            <p class="mb-0 text-muted">View your page on different devices (phone, tablet, desktop) to ensure it looks great everywhere</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6 class="mb-1"><i class="fa fa-bolt text-warning"></i> Collect Reviews Proactively</h6>
                                            <p class="mb-0 text-muted">After successful projects, send clients your vCard link and ask them to leave a review</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6 class="mb-1"><i class="fa fa-bolt text-warning"></i> Automate Email Follow-ups</h6>
                                            <p class="mb-0 text-muted">Set up welcome email sequences for new leads and nurture campaigns for different audience segments</p>
                                        </div>
                                        <div class="list-group-item">
                                            <h6 class="mb-1"><i class="fa fa-bolt text-warning"></i> Segment Your Lists</h6>
                                            <p class="mb-0 text-muted">Create different mailing lists for different lead sources and send targeted content to each group</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Call to Action -->
                            <div class="card bg-primary text-white text-center">
                                <div class="card-body p-5">
                                    <h3 class="mb-3">Ready to Get Started?</h3>
                                    <p class="lead mb-4">Create your Vinculum vCard now and start networking smarter!</p>
                                    <a href="/web" class="btn btn-light btn-lg">
                                        <i class="fa fa-arrow-left"></i> Back to Dashboard
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <style>
                .timeline {
                    position: relative;
                    padding-left: 20px;
                }
                .timeline::before {
