<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Record-level isolation for Vinc models.

        Regular internal users (base.group_user) only see records where
        create_uid matches their own uid. Vinc Managers (and Odoo
        administrators, who imply group_vinc_manager) see everything.

        For child records (partner.vcard.website / videos / reviews /
        speciality / service / service.question), we scope via the parent's
        create_uid so the child rule survives admin-driven creates that
        bypass child.create_uid.

        bulk.onboarding.* models intentionally have NO user rule: they are
        manager-only in ir.model.access.csv. The magic-link activation
        controller looks up tokens via sudo() by token value (not via RPC
        search_read), so locking RPC access to managers does not break the
        activation flow.
    -->
    <data noupdate="1">

        <!-- partner.vcard -->
        <record id="rule_partner_vcard_user" model="ir.rule">
            <field name="name">Vinc card: own</field>
            <field name="model_id" ref="model_partner_vcard"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_partner_vcard_manager" model="ir.rule">
            <field name="name">Vinc card: manager</field>
            <field name="model_id" ref="model_partner_vcard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('qr_code_odoo.group_vinc_manager'))]"/>
        </record>

        <!-- partner.vcard.website -->
        <record id="rule_partner_vcard_website_user" model="ir.rule">
            <field name="name">Vinc card website: own parent</field>
            <field name="model_id" ref="model_partner_vcard_website"/>
            <field name="domain_force">[('partner_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_partner_vcard_website_manager" model="ir.rule">
