<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Hide the Schedule Meeting button in CRM Lead form -->
        <record id="crm_lead_form_view_inherit" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit.hide_meeting_button</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <button name="action_schedule_meeting" position="attributes">
                    <attribute name="invisible">True</attribute>
                </button>
                
                <!-- Surface the source event next to the lead title so it's
                     immediately visible without opening a tab. -->
                <xpath expr="//h1[field[@name='name']]" position="after">
                    <div class="o_row" invisible="not event_id">
                        <span class="badge text-bg-info me-2">Captured at:</span>
                        <field name="event_id" readonly="1" nolabel="1"/>
                    </div>
                </xpath>

                <!-- Look-alike smart-buttons. Companies and open leads scored
                     separately so each gets its own pitch / coordination angle. -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="lookalike_partner_count" invisible="1"/>
                    <field name="lookalike_lead_count" invisible="1"/>
                    <field name="lookalike_hint" invisible="1"/>
                    <button name="action_view_lookalike_partners" type="object"
                            class="oe_stat_button" icon="fa-building"
                            invisible="lookalike_partner_count == 0">
                        <field name="lookalike_partner_count" widget="statinfo" string="Similar Companies"/>
                    </button>
                    <button name="action_view_lookalike_leads" type="object"
                            class="oe_stat_button" icon="fa-bullseye"
                            invisible="lookalike_lead_count == 0">
                        <field name="lookalike_lead_count" widget="statinfo" string="Similar Leads"/>
                    </button>
                </xpath>

                <!-- Look-alikes notebook tab. Tab hides itself when there are no matches
                     so reps don't see an empty page. The smart-buttons stay at the top
                     for quick navigation; this tab is the conversation-starter detail view. -->
                <xpath expr="//notebook" position="inside">
                    <page string="Look-alikes" name="lookalikes"
                          invisible="lookalike_partner_count == 0 and lookalike_lead_count == 0">
                        <field name="lookalike_summary" nolabel="1" readonly="1" widget="html"/>
                    </page>
                </xpath>

                <!-- Add Submission Tracking Information Tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Submission Tracking" name="submission_tracking" invisible="not submission_ip">
                        <group string="Location &amp; Device Information">
                            <group>
                                <field name="submission_ip" readonly="1"/>
                                <field name="submission_country" readonly="1"/>
                                <field name="submission_city" readonly="1"/>
                                <field name="submission_timezone" readonly="1"/>
                            </group>
                            <group>
                                <field name="submission_device_type" readonly="1"/>
                                <field name="submission_browser" readonly="1"/>
                                <field name="submission_os" readonly="1"/>
                                <field name="submission_language" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Source &amp; Campaign Tracking">
                            <group>
                                <field name="submission_source_url" readonly="1" widget="url"/>
                                <field name="submission_referral_code" readonly="1"/>
                            </group>
                            <group>
                                <field name="submission_utm_source" readonly="1"/>
                                <field name="submission_utm_medium" readonly="1"/>
                                <field name="submission_utm_campaign" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Technical Details" invisible="not submission_user_agent">
                            <field name="submission_user_agent" readonly="1" widget="text"/>
                            <field name="submission_fingerprint_hash" readonly="1" widget="text"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
