<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bulk onboarding — admin templates, styled for the .vg-bulk scope in
        static/src/css/bulk_onboard.css. Mirrors the /get-started editorial
        system (Fraunces + DM Sans, navy hero, blue accents, white page).

        Three admin screens:
          bulk_onboarding_index       — /bulk-onboard landing dashboard
          bulk_onboarding_wizard      — /bulk-onboard/new 3-chapter creation flow
          bulk_onboarding_batch_view  — /bulk-onboard/batch/<id> operational view

        The previous complete_vcard_page template has been removed — recipients
        are now routed through /get-started?flow=bulk-activate so they get the
        same editorial card-completion flow admins use, with pre-filled values
        the admin supplied during bulk onboarding.

        Every form field name is preserved from the prior version so the
        controllers in controllers/bulk_onboarding.py (submit_bulk_onboard,
        upload_file, resend endpoints) work unchanged.
    -->


    <!-- ============================================================== -->
    <!-- Landing dashboard — hero + batches table                       -->
    <!-- ============================================================== -->
    <template id="bulk_onboarding_index" name="Bulk Onboarding">
        <t t-call="website.layout">
            <div class="vg-bulk" id="bk-root">
                <div class="bk-shell">

                    <section class="bk-hero">
                        <div class="bk-hero-row">
                            <div class="bk-hero-inner">
                                <div class="bk-hero-eyebrow">Bulk onboarding</div>
                                <h1>Onboard a <em>whole team</em> in one upload.</h1>
                                <p class="bk-hero-sub">
                                    Drop in a CSV or type in a few names. Every row becomes a ready-to-activate Vinc card with an invite email on its way.
                                </p>
                            </div>
                            <a href="/bulk-onboard/new" class="bk-btn bk-btn-primary">
                                <span>Create new batch</span>
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </section>

                    <div class="bk-card">
                        <div class="bk-card-head">
                            <h2 class="bk-card-title">Recent batches</h2>
                            <span class="bk-chip">
                                <span class="bk-chip-num" t-esc="len(batches)"/>
                                <span>total</span>
                            </span>
                        </div>

                        <div class="bk-card-body bk-card-body-flush">
                            <t t-if="not batches">
                                <div class="bk-empty">
                                    <div class="bk-empty-icon" aria-hidden="true">↑</div>
                                    <h3>No batches yet</h3>
                                    <p>Create your first batch to start onboarding your team. You can upload a CSV of up to 500 rows or type reps in manually.</p>
                                    <a href="/bulk-onboard/new" class="bk-btn bk-btn-primary">
                                        <span>Create first batch</span>
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </t>
                            <t t-if="batches">
                                <div class="bk-table-scroll">
                                    <table class="bk-table">
                                        <thead>
                                            <tr>
                                                <th>Batch</th>
                                                <th>Status</th>
                                                <th>Total</th>
                                                <th>Invited</th>
                                                <th>Activated</th>
                                                <th>Completed</th>
                                                <th>Created</th>
                                                <th class="bk-col-tight"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="batches" t-as="batch">
                                                <tr>
                                                    <td>
                                                        <a t-attf-href="/bulk-onboard/batch/#{batch.id}">
                                                            <t t-esc="batch.name"/>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <span class="bk-status" t-att-data-status="batch.status or 'draft'">
                                                            <t t-esc="(batch.status or 'draft').replace('_', ' ')"/>
                                                        </span>
                                                    </td>
                                                    <td><t t-esc="batch.total_reps or 0"/></td>
                                                    <td><t t-esc="batch.invited_reps or 0"/></td>
                                                    <td><t t-esc="batch.activated_reps or 0"/></td>
                                                    <td><t t-esc="batch.completed_reps or 0"/></td>
                                                    <td>
                                                        <t t-esc="batch.create_date.strftime('%b %d, %Y') if batch.create_date else ''"/>
                                                    </td>
                                                    <td class="bk-col-tight">
                                                        <a t-attf-href="/bulk-onboard/batch/#{batch.id}" class="bk-btn bk-btn-ghost bk-btn-sm">
                                                            Open →
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>


    <!-- ============================================================== -->
    <!-- Create-batch wizard — 3 chapters                               -->
    <!-- ============================================================== -->
    <template id="bulk_onboarding_wizard" name="Bulk Onboard Users">
        <t t-call="website.layout">
            <div class="vg-bulk" id="bk-wizard">
                <div class="bk-shell">

                    <!-- Compact top bar (no hero — this is a flow, not a landing) -->
                    <div class="bk-topbar">
                        <div class="bk-topbar-head">
                            <div class="bk-breadcrumb">
                                <a href="/bulk-onboard">Bulk onboarding</a>
                                <span class="bk-breadcrumb-sep">/</span>
                                <span>New batch</span>
                            </div>
                            <h1>Create a new batch.</h1>
                        </div>
                        <a href="/bulk-onboard" class="bk-btn bk-btn-ghost bk-btn-sm">
                            <span aria-hidden="true">←</span>
                            <span>Cancel</span>
                        </a>
                    </div>

                    <!-- 3-chapter pill stepper -->
                    <div class="bk-stepper-card">
                        <div class="bk-stepper" role="tablist" aria-label="Batch creation progress">
                            <button type="button" class="bk-step" data-step="1" data-state="active" aria-current="step">
                                <span class="bk-step-bullet"><span>1</span></span>
                                <span class="bk-step-label">Import</span>
                            </button>
                            <button type="button" class="bk-step" data-step="2" data-state="upcoming">
                                <span class="bk-step-bullet"><span>2</span></span>
                                <span class="bk-step-label">Shared defaults</span>
                            </button>
                            <button type="button" class="bk-step" data-step="3" data-state="upcoming">
                                <span class="bk-step-bullet"><span>3</span></span>
                                <span class="bk-step-label">Review &amp; send</span>
                            </button>
                            <span class="bk-stepper-progress" data-progress-track="true"/>
                        </div>
                    </div>

                    <t t-if="error">
                        <div class="bk-alert" data-tone="error" role="alert">
                            <strong>Something went wrong:</strong>
                            <span t-esc="error"/>
                        </div>
                    </t>

                    <form id="bk-form" action="/bulk-onboard/submit" method="post" enctype="multipart/form-data" novalidate="novalidate">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="rep_data_json" id="bk-rep-data-json" value=""/>
                        <input type="hidden" name="brand_color" id="bk-brand-color" value="#2D5BFF"/>
                        <input type="hidden" name="website_template" id="bk-selected-template" value="modern"/>

                        <!-- =========================================== -->
                        <!-- Chapter 1 · Import                          -->
                        <!-- =========================================== -->
                        <section class="bk-chapter" data-chapter="1" data-active="true">
                            <header class="bk-chapter-head">
                                <div class="bk-chapter-eyebrow">Chapter 01 · Import</div>
                                <h2 class="bk-chapter-title">Who are we <em>onboarding</em>?</h2>
                                <p class="bk-chapter-intro">Upload a CSV (up to 500 rows) or type people in by hand. You can switch between modes — we'll carry the names across.</p>
                            </header>
                            <div class="bk-chapter-body">

                                <div class="bk-import-tabs" role="tablist">
                                    <button type="button" class="bk-import-tab" data-import-tab="upload" data-active="true" role="tab">Upload CSV / Excel</button>
                                    <button type="button" class="bk-import-tab" data-import-tab="manual" role="tab">Type reps in</button>
                                </div>

                                <!-- Upload panel.
                                     NOTE: the "Download starter CSV" link lives OUTSIDE the
                                     <label> on purpose. Native HTML promotes any click inside
                                     a <label> that contains a form control into a click on
                                     that control — event.stopPropagation() on the link does
                                     not override it. Pulled out below the dropzone. -->
                                <div class="bk-import-panel" data-import-panel="upload" data-active="true">
                                    <label class="bk-drop" data-state="empty" id="bk-dropzone">
                                        <span class="bk-drop-icon" aria-hidden="true">↑</span>
                                        <span class="bk-drop-label">Drop your file here, or click to browse</span>
                                        <span class="bk-drop-hint">CSV or Excel (.xlsx, .xls). Maximum 2&#160;MB, 500 rows per batch.</span>
                                        <span class="bk-drop-meta">
                                            <span class="bk-drop-filename" data-drop-filename="true"></span>
                                            <span class="bk-drop-count" data-drop-count="true"></span>
                                        </span>
                                        <button type="button" class="bk-drop-reset" data-drop-reset="true">Change file</button>
                                        <input type="file" id="bk-file-input" accept=".csv,.xlsx,.xls"/>
                                    </label>
                                    <div class="bk-drop-footer">
                                        <span>Don't have a file?</span>
                                        <a href="/bulk-onboard/template" class="bk-drop-link">Download starter CSV →</a>
                                    </div>
                                    <div class="bk-alert" data-tone="info" id="bk-upload-status" style="display: none; margin-top: 16px;"></div>
                                </div>

                                <!-- Manual entry panel -->
                                <div class="bk-import-panel" data-import-panel="manual">
                                    <div class="bk-rep-rows" id="bk-rep-rows">
                                        <div class="bk-rep-row" data-rep-row="true">
                                            <input type="text" name="rep_name[]" placeholder="Name" aria-label="Name"/>
                                            <input type="email" name="rep_email[]" placeholder="Email" aria-label="Email"/>
                                            <input type="tel" name="rep_phone[]" placeholder="Phone" aria-label="Phone"/>
                                            <input type="text" name="rep_function[]" placeholder="Job title" aria-label="Job title"/>
                                            <button type="button" class="bk-rep-remove" data-rep-remove="true" aria-label="Remove rep">×</button>
                                        </div>
                                    </div>
                                    <button type="button" class="bk-rep-add" id="bk-rep-add">Add another row</button>
                                </div>

                            </div>
                            <div class="bk-actions">
                                <span/>
                                <button type="button" class="bk-btn bk-btn-primary" data-action="next">
                                    <span>Next · Shared defaults</span>
                                    <span aria-hidden="true">→</span>
                                </button>
                            </div>
                        </section>

                        <!-- =========================================== -->
                        <!-- Chapter 2 · Shared defaults                 -->
                        <!-- =========================================== -->
                        <section class="bk-chapter" data-chapter="2" data-active="false">
                            <header class="bk-chapter-head">
                                <div class="bk-chapter-eyebrow">Chapter 02 · Shared defaults</div>
                                <h2 class="bk-chapter-title">Applied to <em>every</em> card in this batch.</h2>
                                <p class="bk-chapter-intro">Company, color, template, company social links — recipients can still edit their own card afterward.</p>
                            </header>
                            <div class="bk-chapter-body">

                                <div class="bk-subhead">
                                    <h3 class="bk-subhead-title">Brand</h3>
                                    <p class="bk-subhead-note">The basics every card in the batch inherits.</p>
                                </div>
                                <div class="bk-grid">
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-company">Company name</label>
                                        <input class="gs-input" type="text" id="bk-company" name="company_name" placeholder="Your Company"/>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-brand-color-visible">Brand color</label>
                                        <input class="gs-input" type="color" id="bk-brand-color-visible" value="#2D5BFF" data-syncs-to="bk-brand-color" style="height: 46px; padding: 4px;"/>
                                    </div>
                                    <div class="gs-field bk-col-full">
                                        <label class="gs-label" for="bk-default-about">Default About text</label>
                                        <textarea class="gs-textarea" id="bk-default-about" name="default_about" placeholder="A sentence or two about the team. Recipients can override on their own card."/>
                                    </div>
                                </div>

                                <div class="bk-subhead">
                                    <h3 class="bk-subhead-title">Template</h3>
                                    <p class="bk-subhead-note">Pick the card layout. Recipients can switch later if they want.</p>
                                </div>
                                <div class="bk-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
                                    <t t-foreach="[('classic','Classic'),('modern','Modern'),('corporate','Corporate'),('minimal','Minimal'),('creative','Creative')]" t-as="tpl">
                                        <label class="gs-field" style="cursor: pointer;">
                                            <input type="radio" name="bk_tpl_radio" t-att-value="tpl[0]" data-template-choice="true" t-att-checked="'checked' if tpl[0] == 'modern' else None" style="position: absolute; opacity: 0;"/>
                                            <span class="bk-summary-tile" style="cursor: pointer; transition: all 0.15s ease;">
                                                <span class="bk-summary-label">Template</span>
                                                <span class="bk-summary-value" style="font-size: 18px;"><t t-esc="tpl[1]"/></span>
                                            </span>
                                        </label>
                                    </t>
                                </div>

                                <div class="bk-subhead">
                                    <h3 class="bk-subhead-title">Shared address</h3>
                                    <p class="bk-subhead-note">Optional — used as the default for every card.</p>
                                </div>
                                <div class="bk-grid">
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-street">Street</label>
                                        <input class="gs-input" type="text" id="bk-street" name="default_street"/>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-street2">Street 2</label>
                                        <input class="gs-input" type="text" id="bk-street2" name="default_street2"/>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-city">City</label>
                                        <input class="gs-input" type="text" id="bk-city" name="default_city"/>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-zip">ZIP / Postal code</label>
                                        <input class="gs-input" type="text" id="bk-zip" name="default_zip"/>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-country">Country</label>
                                        <select class="gs-select" id="bk-country" name="country_id">
                                            <option value="">Select a country</option>
                                            <t t-foreach="countries" t-as="country">
                                                <option t-att-value="country.id"><t t-esc="country.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-state">State / Province</label>
                                        <select class="gs-select" id="bk-state" name="state_id">
                                            <option value="">Select a state</option>
                                            <t t-foreach="states" t-as="state">
                                                <option t-att-value="state.id" t-att-data-country-id="state.country_id.id"><t t-esc="state.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <div class="bk-subhead">
                                    <h3 class="bk-subhead-title">Company social links</h3>
                                    <p class="bk-subhead-note">Optional — company-level profiles shared by every card.</p>
                                </div>
                                <div class="bk-grid">
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-li-co">Company LinkedIn</label>
                                        <input class="gs-input" type="url" id="bk-li-co" name="linkedin_url_company" placeholder="https://www.linkedin.com/company/…"/>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-fb-co">Company Facebook</label>
                                        <input class="gs-input" type="url" id="bk-fb-co" name="facebook_url_company" placeholder="https://www.facebook.com/…"/>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-tw-co">Company Twitter / X</label>
                                        <input class="gs-input" type="url" id="bk-tw-co" name="twitter_url_company"/>
                                    </div>
                                    <div class="gs-field">
                                        <label class="gs-label" for="bk-ig-co">Company Instagram</label>
                                        <input class="gs-input" type="url" id="bk-ig-co" name="instagram_url_company"/>
                                    </div>
                                </div>

                                <div class="bk-subhead">
                                    <h3 class="bk-subhead-title">Lead capture defaults</h3>
                                    <p class="bk-subhead-note">Applied to every card in this batch.</p>
                                </div>
                                <div class="gs-toggle-row">
                                    <div class="gs-toggle-info">
                                        <span class="gs-toggle-label">Show lead collection form</span>
                                        <span class="gs-toggle-desc">Enable the "Get in touch" button on every card.</span>
                                    </div>
                                    <button type="button" class="gs-toggle" role="switch" aria-checked="false" data-toggle-target="show_form"/>
                                    <input type="checkbox" name="show_form" id="show_form_yes" value="yes" class="gs-sr-only" data-linked-toggle="true"/>
                                </div>
                                <div class="gs-reveal" id="bk-lead-extras">
                                    <div class="bk-grid">
                                        <div class="gs-field">
                                            <label class="gs-label" for="bk-list-name">Mailing list name</label>
                                            <input class="gs-input" type="text" id="bk-list-name" name="mailing_list_name" placeholder="Main Contacts"/>
                                        </div>
                                        <div class="gs-field">
                                            <label class="gs-label" for="bk-lead-btn">Lead button label</label>
                                            <input class="gs-input" type="text" id="bk-lead-btn" name="lead_button_label" placeholder="Get in touch"/>
                                        </div>
                                        <div class="gs-field bk-col-full">
                                            <label class="gs-label" for="bk-thanks">Thank-you message</label>
                                            <input class="gs-input" type="text" id="bk-thanks" name="form_thank_you_message" placeholder="Thanks! We'll be in touch."/>
                                        </div>
                                    </div>
                                </div>
                                <div class="gs-toggle-row">
                                    <div class="gs-toggle-info">
                                        <span class="gs-toggle-label">Notify card owner on new lead</span>
                                        <span class="gs-toggle-desc">Email the card owner when someone submits the lead form.</span>
                                    </div>
                                    <button type="button" class="gs-toggle" role="switch" aria-checked="false" data-toggle-target="notify_on_new_lead"/>
                                    <input type="checkbox" name="notify_on_new_lead" id="notify_on_new_lead_yes" value="yes" class="gs-sr-only" data-linked-toggle="true"/>
                                </div>
                                <div class="gs-toggle-row">
                                    <div class="gs-toggle-info">
                                        <span class="gs-toggle-label">Send intro email automatically</span>
                                        <span class="gs-toggle-desc">Every new lead gets a branded intro email from the card owner.</span>
                                    </div>
                                    <button type="button" class="gs-toggle" role="switch" aria-checked="false" data-toggle-target="intro_email_enabled"/>
                                    <input type="checkbox" name="intro_email_enabled" id="intro_email_enabled_yes" value="yes" class="gs-sr-only" data-linked-toggle="true"/>
                                </div>
                                <div class="gs-toggle-row">
                                    <div class="gs-toggle-info">
                                        <span class="gs-toggle-label">Show reviews section</span>
                                        <span class="gs-toggle-desc">Display a reviews carousel on every card.</span>
                                    </div>
                                    <button type="button" class="gs-toggle" role="switch" aria-checked="false" data-toggle-target="show_reviews"/>
                                    <input type="checkbox" name="show_reviews" id="show_reviews_yes" value="yes" class="gs-sr-only" data-linked-toggle="true"/>
                                </div>

                            </div>
                            <div class="bk-actions">
                                <button type="button" class="bk-btn bk-btn-ghost" data-action="back">
                                    <span aria-hidden="true">←</span>
                                    <span>Back</span>
                                </button>
                                <button type="button" class="bk-btn bk-btn-primary" data-action="next">
                                    <span>Next · Review &amp; send</span>
                                    <span aria-hidden="true">→</span>
                                </button>
                            </div>
                        </section>

                        <!-- =========================================== -->
                        <!-- Chapter 3 · Review & send                   -->
                        <!-- =========================================== -->
                        <section class="bk-chapter" data-chapter="3" data-active="false">
                            <header class="bk-chapter-head">
                                <div class="bk-chapter-eyebrow">Chapter 03 · Review &amp; send</div>
                                <h2 class="bk-chapter-title">One last <em>look</em> before we email.</h2>
                                <p class="bk-chapter-intro">Each rep below gets a magic-link email with instructions to activate their card.</p>
                            </header>
                            <div class="bk-chapter-body">

                                <div class="bk-review-summary">
                                    <div class="bk-summary-tile">
                                        <div class="bk-summary-label">Reps in this batch</div>
                                        <div class="bk-summary-value" data-summary-count="true">0</div>
                                    </div>
                                    <div class="bk-summary-tile">
                                        <div class="bk-summary-label">Template</div>
                                        <div class="bk-summary-value" style="font-size: 18px;" data-summary-template="true">Modern</div>
                                    </div>
                                    <div class="bk-summary-tile">
                                        <div class="bk-summary-label">Brand color</div>
                                        <div class="bk-summary-value" style="font-size: 18px; display: flex; align-items: center; gap: 10px;">
                                            <span data-summary-color-swatch="true" style="width: 20px; height: 20px; border-radius: 6px; background: #2D5BFF; border: 1px solid rgba(14,27,58,0.12);"></span>
                                            <span data-summary-color-hex="true">#2D5BFF</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="bk-subhead">
                                    <h3 class="bk-subhead-title">Reps to invite</h3>
                                    <p class="bk-subhead-note" data-summary-source="true">—</p>
                                </div>
                                <div class="bk-table-scroll">
                                    <table class="bk-table">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Phone</th>
                                                <th>Job title</th>
                                            </tr>
                                        </thead>
                                        <tbody id="bk-review-tbody"></tbody>
                                    </table>
                                </div>
                                <div class="bk-alert" data-tone="info" id="bk-review-empty" style="display: none; margin-top: 16px;">
                                    Go back to chapter 1 and add at least one rep before sending.
                                </div>

                                <div class="bk-subhead">
                                    <h3 class="bk-subhead-title">Name this batch</h3>
                                    <p class="bk-subhead-note">Shown in your batch list. Defaults to today's date if left blank.</p>
                                </div>
                                <div class="gs-field">
                                    <input class="gs-input" type="text" name="batch_name" placeholder="e.g. Sales team – April 2026"/>
                                </div>

                            </div>
                            <div class="bk-actions">
                                <button type="button" class="bk-btn bk-btn-ghost" data-action="back">
                                    <span aria-hidden="true">←</span>
                                    <span>Back</span>
                                </button>
                                <button type="submit" class="bk-btn bk-btn-primary" data-action="submit" id="bk-submit">
                                    <span class="bk-btn-label">Create batch &amp; send invites</span>
                                    <span aria-hidden="true">→</span>
                                </button>
                            </div>
                        </section>

                    </form>

                </div>
            </div>
        </t>
    </template>


    <!-- ============================================================== -->
    <!-- Batch detail view — operational                                 -->
    <!-- ============================================================== -->
    <template id="bulk_onboarding_batch_view" name="Bulk Onboarding Batch">
        <t t-call="website.layout">
            <div class="vg-bulk" id="bk-batch">
                <div class="bk-shell">

                    <div class="bk-topbar">
                        <div class="bk-topbar-head">
                            <div class="bk-breadcrumb">
                                <a href="/bulk-onboard">Bulk onboarding</a>
                                <span class="bk-breadcrumb-sep">/</span>
                                <span t-esc="batch.name"/>
                            </div>
                            <h1 t-esc="batch.name"/>
                        </div>
                        <div class="bk-stats-row">
                            <span class="bk-chip" data-tone="blue">
                                <span class="bk-chip-num" t-esc="batch.total_reps or 0"/>
                                <span>total</span>
                            </span>
                            <span class="bk-chip" data-tone="blue">
                                <span class="bk-chip-num" t-esc="batch.invited_reps or 0"/>
                                <span>invited</span>
                            </span>
                            <span class="bk-chip" data-tone="amber">
                                <span class="bk-chip-num" t-esc="batch.activated_reps or 0"/>
                                <span>activated</span>
                            </span>
                            <span class="bk-chip" data-tone="green">
                                <span class="bk-chip-num" t-esc="batch.completed_reps or 0"/>
                                <span>completed</span>
                            </span>
                            <t t-if="batch.failed_reps">
                                <span class="bk-chip" data-tone="red">
                                    <span class="bk-chip-num" t-esc="batch.failed_reps"/>
                                    <span>failed</span>
                                </span>
                            </t>
                        </div>
                    </div>

                    <t t-set="pending_count" t-value="len(batch.rep_ids.filtered(lambda r: r.status == 'pending'))"/>
                    <div class="bk-actionbar">
                        <t t-if="pending_count">
                            <button type="button" class="bk-btn bk-btn-primary bk-btn-sm" id="bk-process-batch" t-att-data-batch-id="batch.id">
                                Process <t t-esc="pending_count"/> pending
                            </button>
                        </t>
                        <form method="post" t-attf-action="/bulk-onboard/batch/#{batch.id}/delete"
                              onsubmit="return confirm('Delete this entire batch and all its reps? This cannot be undone.');"
                              style="display:inline;">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="bk-btn bk-btn-ghost bk-btn-sm" data-tone="danger">
                                Delete batch
                            </button>
                        </form>
                    </div>

                    <t t-if="show_started_message">
                        <div class="bk-alert" data-tone="success" role="status">
                            <strong>Batch started.</strong>
                            <span>Invitations are being sent in the background — refresh in a minute to see delivery status.</span>
                        </div>
                    </t>

                    <div class="bk-card">
                        <div class="bk-card-head">
                            <h2 class="bk-card-title">Reps</h2>
                            <div class="bk-row-actions">
                                <button type="button" class="bk-btn bk-btn-ghost bk-btn-sm" id="bk-add-rep-toggle">
                                    + Add rep
                                </button>
                                <button type="button" class="bk-btn bk-btn-ghost bk-btn-sm" id="bk-bulk-resend" t-att-data-batch-id="batch.id">
                                    Resend invites
                                </button>
                            </div>
                        </div>

                        <!-- Inline "add a rep" form (hidden until toggled, or shown by default when the batch is empty). -->
                        <div class="bk-addrep" id="bk-add-rep-form" t-att-data-batch-id="batch.id" t-att-data-open="'true' if not reps else 'false'">
                            <div class="bk-addrep-grid">
                                <input class="gs-input" type="text" data-addrep="name" placeholder="Full name"/>
                                <input class="gs-input" type="email" data-addrep="email" placeholder="email@company.com"/>
                                <input class="gs-input" type="text" data-addrep="phone" placeholder="Phone (optional)"/>
                                <input class="gs-input" type="text" data-addrep="function" placeholder="Job title (optional)"/>
                            </div>
                            <div class="bk-addrep-actions">
                                <button type="button" class="bk-btn bk-btn-primary bk-btn-sm" id="bk-add-rep-save">Add rep</button>
                                <span class="bk-addrep-hint">The email must already belong to an Odoo user. After adding, click “Process pending”.</span>
                            </div>
                        </div>

                        <div class="bk-card-body bk-card-body-flush">
                            <t t-if="not reps">
                                <div class="bk-empty">
                                    <div class="bk-empty-icon" aria-hidden="true">◯</div>
                                    <h3>No reps in this batch</h3>
                                    <p>This batch has no reps yet. Add one above, or delete the batch.</p>
                                </div>
                            </t>
                            <t t-if="reps">
                                <div class="bk-table-scroll">
                                    <table class="bk-table">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Status</th>
                                                <th class="bk-col-actions"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="reps" t-as="rep">
                                                <tr t-att-data-rep-row="rep.id">
                                                    <td class="bk-cell-name" t-att-data-rep-name="rep.name">
                                                        <span class="bk-cell-name-text"><t t-esc="rep.name"/></span>
                                                        <t t-if="rep.error_message">
                                                            <div class="bk-cell-meta" style="color: var(--gs-red, #DC2626);" t-att-title="rep.error_message">
                                                                <t t-esc="rep.error_message[:80]"/>
                                                                <t t-if="len(rep.error_message) > 80">…</t>
                                                            </div>
                                                        </t>
                                                    </td>
                                                    <td class="bk-cell-email" t-att-data-rep-email="rep.email">
                                                        <span class="bk-cell-email-text"><t t-esc="rep.email"/></span>
                                                    </td>
                                                    <td>
                                                        <span class="bk-status" t-att-data-status="rep.status or 'pending'">
                                                            <t t-esc="(rep.status or 'pending').replace('_', ' ')"/>
                                                        </span>
                                                    </td>
                                                    <td class="bk-col-actions">
                                                        <div class="bk-row-actions" t-att-data-rep-id="rep.id">
                                                            <t t-if="rep.status not in ('completed', 'activated')">
                                                                <button type="button" class="bk-btn bk-btn-ghost bk-btn-sm" data-edit-rep="true" t-att-data-rep-id="rep.id">Edit</button>
                                                            </t>
                                                            <t t-if="rep.status in ('failed', 'pending')">
                                                                <button type="button" class="bk-btn bk-btn-ghost bk-btn-sm" data-reprocess-rep="true" t-att-data-rep-id="rep.id">
                                                                    <t t-esc="'Retry' if rep.status == 'failed' else 'Process'"/>
                                                                </button>
                                                            </t>
                                                            <t t-if="rep.status in ('invited', 'completed')">
                                                                <button type="button" class="bk-btn bk-btn-ghost bk-btn-sm" data-resend-rep="true" t-att-data-rep-id="rep.id">Resend</button>
                                                            </t>
                                                            <button type="button" class="bk-btn bk-btn-ghost bk-btn-sm" data-tone="danger" data-delete-rep="true" t-att-data-rep-id="rep.id">Delete</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

</odoo>
