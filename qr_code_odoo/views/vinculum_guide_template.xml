<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Vinc Guide — shared layout + hub.
        Sub-pages live in vinculum_guide_users.xml and vinculum_guide_admins.xml.
        All sub-pages t-call qr_code_odoo.vinculum_guide_layout.

        Visual system: "Soft Editorial" (Fraunces variable + DM Sans, navy/sand/blue).
        Coexists with the Vinc dashboard's gradient/rounded/blue family.
    -->

    <!-- ========================= SHARED LAYOUT ========================= -->
    <template id="vinculum_guide_layout" name="Vinc Guide Layout">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure vg-shell">
                <style>
/* ---------- font system ---------- */
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..900,0..100&amp;family=DM+Sans:opsz,wght@9..40,400..600&amp;display=swap');

/* ---------- design tokens ---------- */
.vg-shell{
  --vg-bg: #FFFFFF;
  --vg-bg-soft: #F7F5EF;
  --vg-ink: #0E1B3A;
  --vg-ink-soft: #4A557A;
  --vg-ink-faint: #8088A6;
  --vg-line: rgba(14, 27, 58, 0.08);
  --vg-line-soft: rgba(14, 27, 58, 0.04);
  --vg-sand: #E8D9B7;
  --vg-sand-soft: #F0E8D2;
  --vg-blue: #3B82F6;
  --vg-blue-deep: #1E40AF;
  --vg-shadow-card: 0 1px 2px rgba(14,27,58,.04), 0 8px 24px rgba(14,27,58,.06);
  --vg-shadow-soft: 0 1px 2px rgba(14,27,58,.03);
  --vg-radius: 16px;
  --vg-radius-sm: 10px;

  background: var(--vg-bg);
  color: var(--vg-ink);
  font-family: 'DM Sans', system-ui, sans-serif;
  font-feature-settings: 'ss01' on, 'cv11' on;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  min-height: 100vh;
  position: relative;
}
.vg-shell *,
.vg-shell *::before,
.vg-shell *::after{ box-sizing: border-box; }

/* faint grain texture across the whole shell — adds warmth without tinting */
.vg-shell::before{
  content:""; position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background-image: radial-gradient(rgba(14,27,58,.035) 1px, transparent 1px);
  background-size: 4px 4px;
  opacity: .22; mix-blend-mode: multiply;
}

.vg-shell .vg-display{
  font-family: 'Fraunces', 'Iowan Old Style', Georgia, serif;
  font-feature-settings: 'ss01' on, 'liga' on;
  letter-spacing: -0.012em;
}

/* ---------- top bar ---------- */
.vg-topbar{
  position: sticky; top: 0; z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 40px;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: saturate(140%) blur(14px);
  -webkit-backdrop-filter: saturate(140%) blur(14px);
  border-bottom: 1px solid var(--vg-line-soft);
}
.vg-topbar .vg-wordmark{
  font-family: 'Fraunces', serif; font-weight: 600;
  font-variation-settings: "opsz" 28, "SOFT" 30;
  font-size: 22px; letter-spacing: -0.02em; color: var(--vg-ink);
  text-decoration: none;
}
.vg-topbar .vg-wordmark::after{
  content: " ·"; color: var(--vg-sand); margin-left: 4px; font-weight: 300;
}
.vg-topbar .vg-topbar-meta{
  font-size: 13px; color: var(--vg-ink-soft);
  display: flex; align-items: center; gap: 16px;
}
.vg-topbar .vg-topbar-meta a{
  color: var(--vg-ink); text-decoration: none;
  border-bottom: 1px solid var(--vg-sand);
  padding-bottom: 1px; transition: border-color .2s, color .2s;
}
.vg-topbar .vg-topbar-meta a:hover{ color: var(--vg-blue); border-color: var(--vg-blue); }

/* ---------- main grid ---------- */
.vg-grid{
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 64px;
  max-width: 1280px; margin: 0 auto;
  padding: 56px 40px 96px;
  position: relative; z-index: 1;
}
.vg-grid.vg-hub-grid{ grid-template-columns: 280px minmax(0, 1fr); }

/* ---------- sidebar ---------- */
.vg-sidebar{
  position: sticky; top: 92px; align-self: start;
  height: calc(100vh - 120px); overflow-y: auto;
  padding-right: 8px; scrollbar-width: thin;
}
.vg-sidebar .vg-side-eyebrow{
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--vg-ink-faint); font-weight: 500;
  margin: 0 0 10px 14px;
}
.vg-sidebar a.vg-side-hub{
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; border-radius: var(--vg-radius-sm);
  color: var(--vg-ink); text-decoration: none;
  font-family: 'Fraunces', serif; font-size: 17px;
  font-variation-settings: "opsz" 24, "SOFT" 40, "wght" 500;
  margin-bottom: 28px;
  transition: background .15s;
}
.vg-sidebar a.vg-side-hub:hover{ background: var(--vg-bg-soft); }
.vg-sidebar a.vg-side-hub.is-active{
  background: var(--vg-bg-soft);
}
.vg-sidebar a.vg-side-hub::before{
  content: ""; width: 8px; height: 8px; border-radius: 999px;
  background: var(--vg-sand); display: inline-block;
}

.vg-sidebar .vg-nav-group{ margin-bottom: 28px; }
.vg-sidebar .vg-nav-group h4{
  font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 600;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--vg-ink-faint); margin: 0 0 8px 14px;
}
.vg-sidebar .vg-nav-group ul{ list-style: none; padding: 0; margin: 0; }
.vg-sidebar .vg-nav-group li a{
  display: flex; align-items: center; gap: 10px;
  padding: 9px 14px; border-radius: var(--vg-radius-sm);
  color: var(--vg-ink-soft); text-decoration: none;
  font-size: 14.5px; font-weight: 400;
  transition: color .15s, background .15s;
  position: relative;
}
.vg-sidebar .vg-nav-group li a::before{
  content:""; width: 3px; height: 14px; border-radius: 2px;
  background: transparent; flex-shrink: 0;
  transition: background .2s;
}
.vg-sidebar .vg-nav-group li a:hover{ color: var(--vg-ink); background: var(--vg-bg-soft); }
.vg-sidebar .vg-nav-group li a.is-active{
  color: var(--vg-ink); background: var(--vg-bg-soft); font-weight: 500;
}
.vg-sidebar .vg-nav-group li a.is-active::before{ background: var(--vg-blue); }

/* ---------- mobile nav toggle ---------- */
.vg-mobile-nav-btn{ display: none; }
@media (max-width: 900px){
  .vg-grid{ grid-template-columns: 1fr; gap: 32px; padding: 32px 22px 64px; }
  .vg-sidebar{
    position: fixed; top: 0; left: 0; bottom: 0; width: 86%; max-width: 320px;
    background: var(--vg-bg); padding: 80px 18px 24px; height: 100vh;
    border-right: 1px solid var(--vg-line);
    transform: translateX(-100%); transition: transform .25s ease;
    z-index: 60; overflow-y: auto;
  }
  .vg-shell.vg-nav-open .vg-sidebar{ transform: translateX(0); }
  .vg-mobile-nav-btn{
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 12px; background: var(--vg-bg-soft); border: 1px solid var(--vg-line);
    border-radius: 999px; font-size: 12px; color: var(--vg-ink); cursor: pointer;
  }
  .vg-shell.vg-nav-open::after{
    content:""; position: fixed; inset: 0; background: rgba(14,27,58,.4); z-index: 55;
  }
}

/* ---------- main column ---------- */
.vg-main{ min-width: 0; max-width: 760px; }

.vg-breadcrumb{
  font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--vg-ink-faint); margin-bottom: 28px;
  display: flex; gap: 10px; flex-wrap: wrap; align-items: center;
}
.vg-breadcrumb a{ color: var(--vg-ink-faint); text-decoration: none; }
.vg-breadcrumb a:hover{ color: var(--vg-blue); }
.vg-breadcrumb .vg-bc-sep{ color: var(--vg-sand); }
.vg-breadcrumb .vg-bc-current{ color: var(--vg-ink); }

.vg-page-header{ margin-bottom: 48px; }
.vg-page-header h1{
  font-family: 'Fraunces', serif;
  font-size: clamp(40px, 6vw, 64px); line-height: 1.02;
  font-variation-settings: "opsz" 144, "SOFT" 60, "wght" 420;
  letter-spacing: -0.02em; margin: 0 0 18px;
  color: var(--vg-ink);
}
.vg-page-header h1 em{
  font-style: italic; color: var(--vg-blue-deep);
  font-variation-settings: "opsz" 144, "SOFT" 80, "wght" 380;
}
.vg-page-header .vg-summary{
  font-size: 19px; line-height: 1.55; color: var(--vg-ink-soft);
  max-width: 580px; margin: 0;
}

/* ---------- content typography ---------- */
.vg-content{ font-size: 16.5px; line-height: 1.7; color: var(--vg-ink); }
.vg-content > * + *{ margin-top: 1em; }
.vg-content h2{
  font-family: 'Fraunces', serif;
  font-size: 28px; line-height: 1.2;
  font-variation-settings: "opsz" 48, "SOFT" 30, "wght" 500;
  letter-spacing: -0.012em; color: var(--vg-ink);
  margin: 56px 0 14px; padding-top: 8px;
  scroll-margin-top: 112px;
}
.vg-content h2 .vg-h2-num{
  font-family: 'DM Sans', sans-serif; font-feature-settings: 'tnum' on;
  font-size: 12px; font-weight: 500; color: var(--vg-ink-faint);
  letter-spacing: 0.1em; margin-right: 14px; vertical-align: 4px;
}
.vg-content h3{
  font-family: 'Fraunces', serif;
  font-size: 19px; font-variation-settings: "opsz" 24, "SOFT" 20, "wght" 600;
  margin: 32px 0 8px; color: var(--vg-ink); letter-spacing: -0.005em;
}
.vg-content p{ margin: 0 0 1em; color: var(--vg-ink); }
.vg-content p strong{ color: var(--vg-ink); font-weight: 600; }
.vg-content a{
  color: var(--vg-ink); text-decoration: none;
  background: linear-gradient(to top, var(--vg-sand) 0, var(--vg-sand) 35%, transparent 35%);
  padding: 0 2px; transition: color .15s;
}
.vg-content a:hover{ color: var(--vg-blue-deep); }
.vg-content em.vg-mark{
  font-style: normal;
  background: linear-gradient(to top, var(--vg-sand) 0, var(--vg-sand) 35%, transparent 35%);
  padding: 0 2px;
}
.vg-content ol, .vg-content ul{ margin: 14px 0 14px 0; padding-left: 0; list-style: none; }
.vg-content ol{ counter-reset: vg-li; }
.vg-content ol li{
  counter-increment: vg-li;
  position: relative; padding: 4px 0 4px 44px; margin-bottom: 6px;
}
.vg-content ol li::before{
  content: counter(vg-li, decimal-leading-zero);
  position: absolute; left: 0; top: 6px;
  font-family: 'DM Sans', sans-serif; font-feature-settings: 'tnum' on;
  font-size: 11px; font-weight: 600; color: var(--vg-blue);
  letter-spacing: 0.08em; padding-top: 2px;
}
.vg-content ul li{
  position: relative; padding: 2px 0 2px 24px; margin-bottom: 4px;
}
.vg-content ul li::before{
  content: ""; position: absolute; left: 0; top: 12px;
  width: 8px; height: 1px; background: var(--vg-sand);
}

/* callouts */
.vg-note, .vg-warn, .vg-todo{
  border-radius: var(--vg-radius-sm);
  padding: 18px 22px 18px 24px;
  margin: 24px 0; font-size: 15px; line-height: 1.6;
  position: relative;
}
.vg-note{ background: var(--vg-bg-soft); border-left: 3px solid var(--vg-sand); }
.vg-note::before{
  content: "Note"; font-family: 'DM Sans', sans-serif;
  font-size: 10px; font-weight: 600; color: var(--vg-ink-faint);
  letter-spacing: 0.16em; text-transform: uppercase; display: block;
  margin-bottom: 6px;
}
.vg-warn{ background: #FCF3EA; border-left: 3px solid #D97706; }
.vg-warn::before{
  content: "Heads-up"; font-family: 'DM Sans', sans-serif;
  font-size: 10px; font-weight: 600; color: #92400E;
  letter-spacing: 0.16em; text-transform: uppercase; display: block;
  margin-bottom: 6px;
}
.vg-todo{ background: #EEF2FF; border-left: 3px dashed var(--vg-blue); }
.vg-todo::before{
  content: "Needs your input"; font-family: 'DM Sans', sans-serif;
  font-size: 10px; font-weight: 600; color: var(--vg-blue-deep);
  letter-spacing: 0.16em; text-transform: uppercase; display: block;
  margin-bottom: 6px;
}

/* code-ish chips */
.vg-content code, .vg-chip{
  font-family: 'DM Sans', monospace; font-size: 13.5px;
  background: var(--vg-bg-soft); padding: 1px 7px;
  border-radius: 6px; color: var(--vg-ink);
  border: 1px solid var(--vg-line-soft);
}

/* ---------- prev/next ---------- */
.vg-pagination{
  display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
  margin-top: 80px; padding-top: 32px; border-top: 1px solid var(--vg-line);
}
.vg-pagination a{
  display: flex; flex-direction: column; gap: 6px;
  padding: 18px 20px; border-radius: var(--vg-radius);
  background: white; border: 1px solid var(--vg-line);
  color: var(--vg-ink); text-decoration: none;
  transition: border-color .2s, transform .15s, box-shadow .2s;
}
.vg-pagination a:hover{ border-color: var(--vg-sand); transform: translateY(-1px); box-shadow: var(--vg-shadow-soft); }
.vg-pagination .vg-pg-eyebrow{
  font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--vg-ink-faint);
}
.vg-pagination .vg-pg-title{
  font-family: 'Fraunces', serif; font-size: 17px;
  font-variation-settings: "opsz" 24, "SOFT" 30, "wght" 500;
}
.vg-pagination .vg-pg-empty{ visibility: hidden; }
.vg-pagination .vg-pg-next{ text-align: right; }

/* ---------- footer ---------- */
.vg-footer{
  position: relative; z-index: 1;
  border-top: 1px solid var(--vg-line);
  padding: 40px 40px 64px; max-width: 1280px; margin: 0 auto;
  display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  font-size: 13.5px; color: var(--vg-ink-soft);
}
.vg-footer a{ color: var(--vg-ink); text-decoration: none; border-bottom: 1px solid var(--vg-sand); padding-bottom: 1px; }
.vg-footer a:hover{ color: var(--vg-blue); border-color: var(--vg-blue); }
.vg-footer .vg-feedback{ display: flex; gap: 12px; align-items: center; }
.vg-footer .vg-feedback button{
  background: white; border: 1px solid var(--vg-line); border-radius: 999px;
  width: 34px; height: 34px; cursor: pointer; font-size: 14px;
  transition: border-color .15s, transform .15s;
}
.vg-footer .vg-feedback button:hover{ border-color: var(--vg-sand); transform: translateY(-1px); }

/* ---------- HUB-specific ---------- */
.vg-main.vg-hub{ max-width: none; }

.vg-hero{
  position: relative; padding: 24px 0 56px; isolation: isolate;
}
.vg-hero::before{
  content: ""; position: absolute; inset: -40px -60px auto -60px; height: 460px;
  z-index: -1; pointer-events: none; border-radius: 28px;
  background:
    radial-gradient(60% 80% at 12% 18%, rgba(232, 217, 183, 0.55) 0%, transparent 60%),
    radial-gradient(50% 70% at 88% 28%, rgba(59, 130, 246, 0.18) 0%, transparent 65%),
    radial-gradient(70% 90% at 50% 100%, rgba(245, 242, 234, 0.9) 0%, transparent 70%);
  filter: blur(0.5px);
}
.vg-hero .vg-hero-eyebrow{
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--vg-ink-faint); font-weight: 500; margin-bottom: 22px;
  display: inline-flex; align-items: center; gap: 10px;
}
.vg-hero .vg-hero-eyebrow::before{
  content:""; width: 24px; height: 1px; background: var(--vg-sand);
}
.vg-hero h1{
  font-family: 'Fraunces', serif;
  font-size: clamp(48px, 7.5vw, 84px); line-height: .96;
  font-variation-settings: "opsz" 144, "SOFT" 100, "wght" 380;
  letter-spacing: -0.025em; margin: 0 0 22px; color: var(--vg-ink);
  max-width: 900px;
}
.vg-hero h1 em{
  font-style: italic; color: var(--vg-blue-deep);
  font-variation-settings: "opsz" 144, "SOFT" 100, "wght" 360;
}
.vg-hero .vg-hero-sub{
  font-size: 19px; line-height: 1.55; color: var(--vg-ink-soft);
  max-width: 540px; margin: 0 0 32px;
}
.vg-hero .vg-cta{
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 22px; border-radius: 999px;
  background: var(--vg-ink); color: var(--vg-bg);
  font-weight: 500; font-size: 15px; text-decoration: none;
  transition: transform .15s, box-shadow .2s;
}
.vg-hero .vg-cta:hover{ transform: translateY(-1px); box-shadow: 0 8px 24px rgba(14,27,58,.25); }
.vg-hero .vg-cta-secondary{
  margin-left: 14px; color: var(--vg-ink-soft); font-size: 14px;
  text-decoration: none; border-bottom: 1px solid var(--vg-line);
  padding-bottom: 2px;
}
.vg-hero .vg-cta-secondary:hover{ color: var(--vg-blue); border-color: var(--vg-blue); }

.vg-tracks{
  display: grid; grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 20px; margin: 64px 0;
}
@media (max-width: 760px){ .vg-tracks{ grid-template-columns: 1fr; } }
.vg-track-card{
  position: relative; padding: 32px 32px 28px; border-radius: var(--vg-radius);
  background: white; border: 1px solid var(--vg-line);
  text-decoration: none; color: var(--vg-ink); display: block;
  transition: transform .2s, border-color .2s, box-shadow .2s;
  overflow: hidden;
}
.vg-track-card::before{
  content: ""; position: absolute; inset: 0; opacity: 0; transition: opacity .25s;
  background: radial-gradient(140% 100% at 0% 0%, rgba(59,130,246,0.06) 0%, transparent 60%);
}
.vg-track-card:hover{ transform: translateY(-2px); border-color: var(--vg-sand); box-shadow: var(--vg-shadow-card); }
.vg-track-card:hover::before{ opacity: 1; }
.vg-track-card .vg-tc-eyebrow{
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--vg-ink-faint); margin-bottom: 18px; font-weight: 500;
}
.vg-track-card h3{
  font-family: 'Fraunces', serif; font-size: 30px;
  font-variation-settings: "opsz" 60, "SOFT" 60, "wght" 460;
  letter-spacing: -0.018em; margin: 0 0 12px; line-height: 1.1;
}
.vg-track-card p{
  color: var(--vg-ink-soft); font-size: 15.5px; line-height: 1.55;
  margin: 0 0 22px;
}
.vg-track-card .vg-tc-cta{
  font-size: 13px; font-weight: 500; color: var(--vg-blue);
  display: inline-flex; align-items: center; gap: 6px;
  border-bottom: 1px solid transparent; transition: border-color .2s;
}
.vg-track-card:hover .vg-tc-cta{ border-color: var(--vg-blue); }

.vg-inside{
  display: grid; grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 56px; margin: 56px 0;
}
@media (max-width: 760px){ .vg-inside{ grid-template-columns: 1fr; gap: 32px; } }
.vg-inside-col h4{
  font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 600;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--vg-ink-faint); margin: 0 0 18px; padding-bottom: 12px;
  border-bottom: 1px solid var(--vg-line);
}
.vg-inside-list{ list-style: none; padding: 0; margin: 0; }
.vg-inside-list li{
  padding: 14px 0; border-bottom: 1px solid var(--vg-line-soft);
}
.vg-inside-list li:last-child{ border-bottom: none; }
.vg-inside-list a{
  display: block; text-decoration: none; color: var(--vg-ink);
  background: none !important; padding: 0;
}
.vg-inside-list .vg-il-title{
  font-family: 'Fraunces', serif;
  font-size: 18px; font-variation-settings: "opsz" 24, "SOFT" 30, "wght" 500;
  margin-bottom: 4px; letter-spacing: -0.008em;
  transition: color .15s;
}
.vg-inside-list a:hover .vg-il-title{ color: var(--vg-blue-deep); }
.vg-inside-list .vg-il-teaser{
  font-size: 14px; color: var(--vg-ink-soft); line-height: 1.5;
}

.vg-mental{
  margin: 72px 0 32px; padding: 48px;
  border-radius: var(--vg-radius); background: var(--vg-bg-soft);
  border: 1px solid var(--vg-line-soft);
  position: relative; overflow: hidden;
}
.vg-mental::before{
  content: "Mental Model";
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--vg-ink-faint); font-weight: 500;
  display: block; margin-bottom: 16px;
}
.vg-mental h2{
  font-family: 'Fraunces', serif;
  font-size: 32px; font-variation-settings: "opsz" 48, "SOFT" 50, "wght" 460;
  letter-spacing: -0.015em; margin: 0 0 24px; line-height: 1.15;
  max-width: 600px;
}
.vg-mental .vg-mental-flow{
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 32px;
}
@media (max-width: 760px){ .vg-mental .vg-mental-flow{ grid-template-columns: 1fr 1fr; } }
.vg-mental-step{ position: relative; }
.vg-mental-step .vg-ms-num{
  font-family: 'DM Sans', sans-serif; font-feature-settings: 'tnum' on;
  font-size: 11px; color: var(--vg-blue); font-weight: 600; letter-spacing: 0.1em;
  display: block; margin-bottom: 6px;
}
.vg-mental-step .vg-ms-title{
  font-family: 'Fraunces', serif; font-size: 17px;
  font-variation-settings: "opsz" 24, "SOFT" 30, "wght" 500;
  margin-bottom: 4px;
}
.vg-mental-step .vg-ms-body{
  font-size: 13.5px; color: var(--vg-ink-soft); line-height: 1.55;
}

/* ---------- figure / screenshot ---------- */
.vg-figure{
  margin: 32px 0 28px; padding: 0;
  border-radius: var(--vg-radius);
  overflow: hidden; background: white;
  border: 1px solid var(--vg-line);
  box-shadow: var(--vg-shadow-card);
  position: relative;
}
.vg-figure::before{
  content: ""; position: absolute; inset: -1px; pointer-events: none;
  border-radius: var(--vg-radius);
  background: linear-gradient(140deg, rgba(232,217,183,.35) 0%, transparent 40%, transparent 60%, rgba(59,130,246,.08) 100%);
  mix-blend-mode: multiply; opacity: .6;
}
.vg-figure img{
  display: block; width: 100%; height: auto;
  background: var(--vg-bg-soft);
}
.vg-figure figcaption{
  padding: 12px 20px 14px;
  font-size: 12.5px; color: var(--vg-ink-faint);
  border-top: 1px solid var(--vg-line-soft);
  background: white; position: relative; z-index: 1;
  font-family: 'DM Sans', sans-serif;
}
.vg-figure figcaption strong{
  color: var(--vg-ink); font-weight: 500; font-size: 12px;
  text-transform: uppercase; letter-spacing: 0.12em;
  margin-right: 10px;
}
                </style>

                <!-- ===== top bar ===== -->
                <header class="vg-topbar">
                    <a href="/vinculum/guide" class="vg-wordmark">Vinc Guide</a>
                    <div class="vg-topbar-meta">
                        <button class="vg-mobile-nav-btn" type="button" onclick="document.querySelector('.vg-shell').classList.toggle('vg-nav-open')">☰ Topics</button>
                        <t t-if="request.session.uid">
                            <a href="/web">← Back to Vinc</a>
                        </t>
                        <t t-else="">
                            <a href="/web/login">Sign in</a>
                        </t>
                    </div>
                </header>

                <!-- ===== main grid ===== -->
                <div class="vg-grid">
                    <!-- sidebar -->
                    <aside class="vg-sidebar">
                        <p class="vg-side-eyebrow">Vinc Guide</p>
                        <a t-attf-href="/vinculum/guide" t-attf-class="vg-side-hub#{'' if current_topic else ' is-active'}">Overview &amp; tracks</a>

                        <t t-foreach="guide_nav" t-as="group">
                            <div class="vg-nav-group">
                                <h4 t-esc="group['label']"/>
                                <ul>
                                    <t t-foreach="group['topics']" t-as="topic">
                                        <li>
                                            <a t-attf-href="/vinculum/guide/#{topic[0]}"
                                               t-attf-class="#{'is-active' if current_topic == topic[0] else ''}"
                                               t-esc="topic[1]"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </t>
                    </aside>

                    <!-- main content slot -->
                    <main t-attf-class="vg-main#{' vg-hub' if hub_mode else ''}">
                        <t t-out="0"/>

                        <!-- prev / next inside-track navigation (sub-pages only) -->
                        <t t-if="current_topic and (prev_topic or next_topic)">
                            <nav class="vg-pagination">
                                <t t-if="prev_topic">
                                    <a t-attf-href="/vinculum/guide/#{prev_topic[0]}">
                                        <span class="vg-pg-eyebrow">← Previous</span>
                                        <span class="vg-pg-title" t-esc="prev_topic[1]"/>
                                    </a>
                                </t>
                                <t t-else="">
                                    <span class="vg-pg-empty"></span>
                                </t>
                                <t t-if="next_topic">
                                    <a t-attf-href="/vinculum/guide/#{next_topic[0]}" class="vg-pg-next">
                                        <span class="vg-pg-eyebrow">Next →</span>
                                        <span class="vg-pg-title" t-esc="next_topic[1]"/>
                                    </a>
                                </t>
                                <t t-else="">
                                    <span class="vg-pg-empty"></span>
                                </t>
                            </nav>
                        </t>
                    </main>
                </div>

                <!-- ===== footer ===== -->
                <footer class="vg-footer">
                    <div class="vg-feedback">
                        <span>Was this page helpful?</span>
                        <a href="https://getvinc.com/contact" target="_blank" rel="noopener" title="Yes, helpful"><button type="button">👍</button></a>
                        <a href="https://getvinc.com/contact" target="_blank" rel="noopener" title="Needs work"><button type="button">👎</button></a>
                    </div>
                    <div>
                        Need more? <a href="https://getvinc.com/contact" target="_blank" rel="noopener">getvinc.com/contact</a>
                        <span style="color: var(--vg-sand); margin: 0 10px;">·</span>
                        <a href="/web">Open Vinc</a>
                    </div>
                </footer>
            </div>
        </t>
    </template>


    <!-- ============================== HUB ============================== -->
    <template id="vinculum_guide_hub" name="Vinc Guide — Hub">
        <t t-call="qr_code_odoo.vinculum_guide_layout">
            <t t-set="hub_mode" t-value="True"/>

            <!-- HERO -->
            <section class="vg-hero">
                <div class="vg-hero-eyebrow">Welcome to Vinc</div>
                <h1 class="vg-display">
                    Every team member,<br/>
                    a <em>lead-generating</em> channel.
                </h1>
                <p class="vg-hero-sub">
                    Vinc turns digital business cards into a measurable acquisition surface — captured leads, attributed touchpoints, automated follow-up, all inside the Odoo you already run. This guide is how you get there in an afternoon.
                </p>
                <div>
                    <t t-if="guide_user_signed_in and guide_user_has_vcard">
                        <a class="vg-cta" href="/web">Open dashboard <span style="opacity:.6">→</span></a>
                        <a class="vg-cta-secondary" href="/get-started">Or create another card</a>
                    </t>
                    <t t-elif="guide_user_signed_in">
                        <a class="vg-cta" href="/get-started">Create your card <span style="opacity:.6">→</span></a>
                        <a class="vg-cta-secondary" href="/web">Open Vinc backend</a>
                    </t>
                    <t t-else="">
                        <a class="vg-cta" href="/get-started">Create your card <span style="opacity:.6">→</span></a>
                        <a class="vg-cta-secondary" href="/web/login">Already a user? Sign in</a>
                    </t>
                </div>
            </section>

            <!-- TRACK PICKER -->
            <section class="vg-tracks">
                <a href="/vinculum/guide/setup-card" class="vg-track-card">
                    <div class="vg-tc-eyebrow">For users</div>
                    <h3>I'm setting up <em>my</em> card</h3>
                    <p>You'll get a published vCard, a printable QR, and a working lead-capture form. Twenty minutes, no developer required.</p>
                    <span class="vg-tc-cta">Start with Setting Up Your Card →</span>
                </a>
                <a href="/vinculum/guide/bulk-onboard" class="vg-track-card">
                    <div class="vg-tc-eyebrow">For administrators</div>
                    <h3>I'm rolling Vinc out to a <em>team</em></h3>
                    <p>Bulk-onboard a roster from CSV, route leads into the right CRM pipeline, and wire up automated follow-up — at the org level.</p>
                    <span class="vg-tc-cta">Start with Bulk Onboarding →</span>
                </a>
            </section>

            <!-- WHAT'S INSIDE, BY TRACK -->
            <section class="vg-inside">
                <t t-foreach="guide_nav" t-as="group">
                    <div class="vg-inside-col">
                        <h4 t-esc="group['label']"/>
                        <ul class="vg-inside-list">
                            <t t-foreach="group['topics']" t-as="topic">
                                <li>
                                    <a t-attf-href="/vinculum/guide/#{topic[0]}">
                                        <div class="vg-il-title" t-esc="topic[1]"/>
                                        <div class="vg-il-teaser">
                                            <t t-if="topic[0] == 'setup-card'">From a fresh install to a published vCard in under five minutes.</t>
                                            <t t-if="topic[0] == 'share-card'">QR, NFC, URL, email signature — distribution patterns that actually convert.</t>
                                            <t t-if="topic[0] == 'lead-capture'">Turn card visits into qualified leads inside your CRM.</t>
                                            <t t-if="topic[0] == 'reviews'">Collect, moderate, and surface social proof without leaving Odoo.</t>
                                            <t t-if="topic[0] == 'bulk-onboard'">CSV upload, activation emails, and the failure modes you'll hit.</t>
                                            <t t-if="topic[0] == 'crm'">How vCard leads land in <code>crm.lead</code>, routing rules, and pipeline integration.</t>
                                            <t t-if="topic[0] == 'nfc'">Recommended cards, programming via NFC Tools, and testing tips.</t>
                                            <t t-if="topic[0] == 'automations'">Intro emails, leadback flows, weekly digests — the automation stack.</t>
                                        </div>
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </div>
                </t>
            </section>

            <!-- MENTAL MODEL -->
            <section class="vg-mental">
                <h2 class="vg-display">How Vinc earns its place in your stack.</h2>
                <p style="color: var(--vg-ink-soft); font-size: 16px; line-height: 1.65; max-width: 640px; margin: 0;">
                    Most card platforms stop at "share your contact." Vinc closes the loop — every scan, tap, and form submission lives inside the same database your sales team already opens every morning. Four moves, end-to-end:
                </p>
                <div class="vg-mental-flow">
                    <div class="vg-mental-step">
                        <span class="vg-ms-num">01 / Create</span>
                        <div class="vg-ms-title">Build the card</div>
                        <div class="vg-ms-body">Photo, branding, slug, lead form — published as a real Odoo website page.</div>
                    </div>
                    <div class="vg-mental-step">
                        <span class="vg-ms-num">02 / Distribute</span>
                        <div class="vg-ms-title">Get it to people</div>
                        <div class="vg-ms-body">QR, NFC, URL, email signature. Each surface has its own analytics.</div>
                    </div>
                    <div class="vg-mental-step">
                        <span class="vg-ms-num">03 / Capture</span>
                        <div class="vg-ms-title">Turn views into leads</div>
                        <div class="vg-ms-body">A configurable lead form, optional reviews, and intro emails on first contact.</div>
                    </div>
                    <div class="vg-mental-step">
                        <span class="vg-ms-num">04 / Route</span>
                        <div class="vg-ms-title">Hand off to CRM</div>
                        <div class="vg-ms-body">Leads land in <code>crm.lead</code> with full attribution, ready for your existing pipeline.</div>
                    </div>
                </div>
            </section>
        </t>
    </template>

</odoo>
