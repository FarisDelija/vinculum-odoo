<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_intro_email" model="mail.template">
            <field name="name">Introduction Email</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="email_from">${user.email or object.email or 'noreply@localhost'}</field>
            <field name="email_to">${ctx.get('contact_email', object.email_from or '')|safe}</field>
            <field name="subject">Great meeting you today</field>
            <field name="body_html" type="html">
                <t t-raw="ctx.get('email_body_html', '')"/>
            </field>
        </record>
    </data>
</odoo>
