<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Digest Email Template -->
    <record id="email_template_digest" model="mail.template">
        <field name="name">vCard Digest Email</field>
        <field name="model_id" ref="model_partner_vcard"/>
        <field name="subject">${'Today' if object.digest_frequency == 'daily' else ('This Week' if object.digest_frequency == 'weekly' else 'This Month')}'s Digest - ${object.name or 'Your vCard'}</field>
        <field name="email_from">${(object.email_formatted or user.email_formatted)}</field>
        <field name="email_to">${object.email}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #ffffff;">
                <!-- Header -->
                <div style="text-align: center; padding: 20px 0; border-bottom: 2px solid #e0e0e0;">
                    <h1 style="margin: 0; color: #333; font-size: 24px;">📊 Your vCard Digest</h1>
                    <p style="margin: 10px 0 0 0; color: #666; font-size: 14px;">${ctx.get('period_display', 'This Week')}</p>
                </div>

                <!-- Stats Overview -->
                <div style="padding: 30px 0;">
                    <h2 style="color: #333; font-size: 20px; margin: 0 0 20px 0;">📈 Quick Stats</h2>
                    
                    <!-- Leads Section -->
                    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
                        <h3 style="color: #333; font-size: 18px; margin: 0 0 15px 0;">🎯 Leads Captured</h3>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <span style="color: #666;">New Leads:</span>
                            <strong style="color: #007bff; font-size: 18px;">${ctx.get('stats', {}).get('new_leads_count', 0)}</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <span style="color: #666;">Total Leads:</span>
                            <strong style="color: #333; font-size: 18px;">${ctx.get('stats', {}).get('total_leads_count', 0)}</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #666;">Without Follow-up:</span>
                            <strong style="color: #dc3545; font-size: 18px;">${ctx.get('stats', {}).get('leads_without_followup_count', 0)}</strong>
                        </div>
                    </div>

                    <!-- Follow-ups Section -->
                    <div style="background: #fff3cd; padding: 20px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #ffc107;">
                        <h3 style="color: #333; font-size: 18px; margin: 0 0 15px 0;">⏰ Follow-up Reminders</h3>
                        <p style="margin: 0 0 10px 0; color: #666;">
                            <strong style="color: #dc3545; font-size: 18px;">${ctx.get('stats', {}).get('due_followups_count', 0)}</strong> 
                            <span style="color: #666;">due or overdue</span>
                        </p>
                        % if ctx.get('stats', {}).get('due_followups'):
                            <ul style="margin: 10px 0 0 0; padding-left: 20px; color: #666;">
                                % for followup in ctx.get('stats', {}).get('due_followups', [])[:5]:
                                    <li style="margin-bottom: 5px;">
                                        <strong>${followup.get('lead_name', 'Lead')}</strong> - 
                                        ${followup.get('activity_summary', 'Follow-up')}
                                        % if followup.get('overdue'):
                                            <span style="color: #dc3545;">(Overdue)</span>
                                        % endif
                                    </li>
                                % endfor
                            </ul>
                            % if len(ctx.get('stats', {}).get('due_followups', [])) > 5:
                                <p style="margin: 10px 0 0 0; color: #666; font-size: 12px;">
                                    ... and ${len(ctx.get('stats', {}).get('due_followups', [])) - 5} more
                                </p>
                            % endif
                        % else:
                            <p style="margin: 10px 0 0 0; color: #28a745;">✓ All caught up! No follow-ups due.</p>
                        % endif
                    </div>

                    <!-- Usage Section -->
                    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
                        <h3 style="color: #333; font-size: 18px; margin: 0 0 15px 0;">📱 Usage Stats</h3>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <span style="color: #666;">Profile Views:</span>
                            <strong style="color: #333; font-size: 18px;">${ctx.get('stats', {}).get('page_views', 0)}</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #666;">QR Scans:</span>
                            <strong style="color: #333; font-size: 18px;">${ctx.get('stats', {}).get('scans_count', 0)}</strong>
                        </div>
                    </div>
                </div>

                <!-- CTA Section -->
                <div style="text-align: center; padding: 30px 0; border-top: 2px solid #e0e0e0;">
                    <a href="${ctx.get('vcard_url', '#')}" 
                       style="display: inline-block; background-color: #007bff; color: #ffffff; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-weight: bold; font-size: 16px;">
                        View Your vCard →
                    </a>
                    <p style="margin: 20px 0 0 0; color: #666; font-size: 12px;">
                        <a href="${ctx.get('base_url', '')}/web#id=${object.id}&amp;model=partner.vcard&amp;view_type=form&amp;active_id=${object.id}" 
                           style="color: #007bff; text-decoration: none;">Manage Digest Settings</a>
                    </p>
                </div>

                <!-- Footer -->
                <div style="text-align: center; padding: 20px 0; border-top: 1px solid #e0e0e0; color: #999; font-size: 12px;">
                    <p style="margin: 0;">This is an automated digest email from Vinc.</p>
                    <p style="margin: 5px 0 0 0;">You can change your digest preferences in your vCard settings.</p>
                </div>
            </div>
        </field>
    </record>
</odoo>
