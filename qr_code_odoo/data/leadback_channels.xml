<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- WhatsApp Channel -->
        <record id="leadback_channel_whatsapp" model="leadback.messaging.channel">
            <field name="name">WhatsApp</field>
            <field name="code">whatsapp</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
        </record>

        <!-- Viber Channel -->
        <record id="leadback_channel_viber" model="leadback.messaging.channel">
            <field name="name">Viber</field>
            <field name="code">viber</field>
            <field name="sequence">20</field>
            <field name="active">True</field>
        </record>

        <!-- Telegram Channel -->
        <record id="leadback_channel_telegram" model="leadback.messaging.channel">
            <field name="name">Telegram</field>
            <field name="code">telegram</field>
            <field name="sequence">30</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
